<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain console test runner, no test framework because the repo uses no NuGet packages.
       Run it from the repo root: dotnet run, then the project flag, then AutoHotspot.Tests.
       It compiles the pure subnet/conflict logic straight from the main project; nothing here
       touches the registry, adapters or services. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AutoHotspot.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AutoHotspot\HotspotIp\Ipv4Subnet.cs" Link="Ipv4Subnet.cs" />
    <Compile Include="..\AutoHotspot\HotspotIp\HotspotIpLogic.cs" Link="HotspotIpLogic.cs" />
  </ItemGroup>

</Project>
